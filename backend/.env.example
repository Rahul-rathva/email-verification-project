# Environment variables for Email Verification Project

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# For local development:
MONGODB_URI=mongodb://localhost:27017/email-verifier

# For MongoDB Atlas cloud:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/email-verifier?retryWrites=true&w=majority

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Email Verification Settings
SMTP_TIMEOUT=5000
DNS_TIMEOUT=5000

# Logging
LOG_LEVEL=debug